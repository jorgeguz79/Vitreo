---
import type { Principle } from "../../data/site";

interface Props {
  name: Principle["icon"];
}

const { name } = Astro.props;

// Cada entrada es únicamente el contenido interno del <svg> (paths/circles),
// para no repetir los atributos comunes del <svg> en cada ícono.
const paths: Record<Props["name"], string> = {
  handshake: `<circle cx="14" cy="13" r="5"/><path d="M4 30c0-6.5 4.5-11 10-11s10 4.5 10 11"/><circle cx="25" cy="11" r="3.5"/><path d="M32 26c0-4.3-2.8-7.7-6.5-8.7"/>`,
  target: `<circle cx="15" cy="21" r="11"/><circle cx="15" cy="21" r="6"/><circle cx="15" cy="21" r="1.4" fill="currentColor" stroke="none"/><path d="M23 13l7-7M30 5h-6v6"/>`,
  search: `<circle cx="15" cy="15" r="10"/><path d="M22.5 22.5L32 32"/><circle cx="15" cy="12.5" r="3"/><path d="M9.5 19.5c1.2-2.2 3.1-3.4 5.5-3.4s4.3 1.2 5.5 3.4"/>`,
  chain: `<path d="M3 13l9 6.5 3.5-2.5 3.5 2.5 9-6.5"/><path d="M10 17.5l4.2 6.7a2.3 2.3 0 003.7.3"/><path d="M14.5 20.3l3.3 5.4a2.3 2.3 0 003.7.2"/>`,
  chart: `<path d="M4 31V21M13 31V15M22 31V23M31 31V9"/><path d="M5 16l7-6.5 6 4 10-9.5"/><path d="M22 4h6v6"/>`,
};
---

<svg
  class="principle-icon"
  viewBox="0 0 36 36"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>

<style>
  .principle-icon {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
