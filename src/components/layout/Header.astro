---
import { Image } from "astro:assets";
import { navLinks, siteMeta } from "../../data/site";
import logoMark from "../../assets/images/logo-mark.png";
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <Image
        src={logoMark}
        alt={`${siteMeta.name} — Inicio`}
        height={68}
        class="logo-mark"
        loading="eager"
      />
    </a>

    <nav id="site-nav" class="site-nav" data-nav aria-label="Principal">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={siteMeta.investorPortalUrl} target="_blank" rel="noopener noreferrer" class="portal-btn">Portal de inversionistas</a>
    </nav>

    <button
      class="nav-toggle"
      data-nav-toggle
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const nav = document.querySelector<HTMLElement>("[data-nav]");

  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const isOpen = nav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        nav.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Abrir menú");
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(46, 45, 44, 0.72);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 4px solid var(--color-gold);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px clamp(20px, 4vw, 56px);
  }

  .logo {
    display: flex;
    align-items: center;
  }
  .logo-mark {
    width: auto;
    height: 68px;
  }

  @media (max-width: 500px) {
    .logo-mark {
      height: 52px;
    }
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .site-nav a {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-gray);
    padding: 10px 18px;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .site-nav a:hover,
  .site-nav a:focus-visible {
    background: var(--color-gold);
    color: var(--color-carbon);
  }

  .portal-btn {
    font-weight: 700 !important;
    color: var(--color-carbon) !important;
    background: var(--color-white);
  }
  .portal-btn:hover,
  .portal-btn:focus-visible {
    background: var(--color-lemon) !important;
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 900px) {
    .site-nav {
      position: fixed;
      top: 0;
      right: 0;
      height: 100svh;
      width: min(84vw, 340px);
      background: var(--color-carbon);
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      transform: translateX(100%);
      transition: transform 0.35s ease;
      z-index: 120;
      border-left: 4px solid var(--color-gold);
    }
    .site-nav.is-open {
      transform: translateX(0);
    }
    .site-nav a {
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding: 20px 24px;
      font-size: 14px;
    }
    .portal-btn {
      display: none;
    }

    .nav-toggle {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 8px;
      z-index: 130;
    }
    .nav-toggle span {
      width: 22px;
      height: 2px;
      background: var(--color-white);
    }
    .nav-toggle:focus-visible {
      outline: 3px solid var(--color-gold);
      outline-offset: 3px;
    }
  }
</style>
