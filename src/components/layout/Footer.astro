---
import { siteMeta } from "../../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span>
      <strong>{siteMeta.regions}</strong>
      <span class="footer-copy">{siteMeta.name}. © {year}</span>
    </span>
    <span>{siteMeta.sector}</span>
    <span>{siteMeta.tagline}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-carbon);
    color: var(--color-gray);
    padding: 3rem 0 2rem;
    border-top: 4px solid var(--color-gold);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-inner strong {
    color: var(--color-white);
    font-weight: 700;
  }

  .footer-copy {
    display: block;
    font-size: 11px;
    opacity: 0.65;
    margin-top: 0.3rem;
    text-transform: none;
  }
</style>
