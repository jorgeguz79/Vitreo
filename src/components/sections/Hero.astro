---
import { Image } from "astro:assets";
import { siteMeta } from "../../data/site";
import heroImage from "../../assets/images/hero-fachada.jpg";
import monogram from "../../assets/images/Monograma-Blanco.png";
---

<section class="hero">
  <Image
    src={heroImage}
    alt=""
    aria-hidden="true"
    class="hero-bg"
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <Image
    src={monogram}
    alt=""
    aria-hidden="true"
    width={939}
    height={914}
    class="watermark hero-watermark"
    style="--wm-opacity: 0.07;"
    loading="lazy"
  />

  <div class="container grid-12">
    <p class="eyebrow hero-eyebrow" style="grid-column: 1 / -1;">Family office</p>

    <h1 class="hero-title">
      Let&rsquo;s Grow <span class="hero-accent">Together!</span>
    </h1>

    <p class="hero-sub">
      Hacemos crecer el patrimonio de nuestros inversionistas mediante decisiones
      fundamentadas en criterio, transparencia y una visión de largo plazo.
    </p>

    <div class="hero-cta">
      <a href="#nosotros" class="btn btn--fill-gold">Conocer Vítreo</a>
      <a href="#" class="btn btn--outline-light">Portal de inversionistas</a>
    </div>

    <div class="hero-foot">
      <span>{siteMeta.regions}</span>
      <span>{siteMeta.sector}</span>
      <span>{siteMeta.tagline}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 94svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 140px 0 60px;
    color: var(--color-white);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* Scrim para asegurar contraste de texto sobre la foto, en cualquier tamaño */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgba(46, 45, 44, 0.93) 0%,
      rgba(46, 45, 44, 0.88) 30%,
      rgba(46, 45, 44, 0.68) 52%,
      rgba(46, 45, 44, 0.38) 72%,
      rgba(46, 45, 44, 0.12) 92%,
      rgba(46, 45, 44, 0.02) 100%
    );
  }

  .hero-watermark {
    right: -6%;
    top: 6%;
  }

  .hero-eyebrow {
    color: var(--color-gold);
  }
  .hero-eyebrow::after {
    display: none;
  }

  .hero-title {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(2.8rem, 7.5vw, 6.4rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    grid-column: 1 / 11;
  }

  .hero-accent {
    background: linear-gradient(100deg, var(--color-gold) 20%, var(--color-lemon) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--color-gold); /* fallback si el navegador no soporta background-clip: text */
  }

  .hero-sub {
    grid-column: 1 / 6;
    margin-top: 2.5rem;
    font-size: 1.08rem;
    font-weight: 300;
    color: var(--color-gray);
  }

  .hero-cta {
    grid-column: 1 / 6;
    display: flex;
    gap: 1rem;
    margin-top: 2.75rem;
    flex-wrap: wrap;
  }

  .hero-foot {
    grid-column: 1 / -1;
    margin-top: auto;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 900px) {
    .hero-title,
    .hero-sub,
    .hero-cta {
      grid-column: 1 / -1;
    }
    .hero-sub {
      margin-top: 1.75rem;
    }
    .hero-foot {
      flex-wrap: nowrap;
      font-size: 8px;
      gap: 0.6rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .hero-foot::-webkit-scrollbar {
      display: none;
    }
    .hero-foot span {
      white-space: nowrap;
    }
  }

  @media (max-width: 500px) {
    .hero-foot {
      font-size: 8px;
      letter-spacing: 0.03em;
      gap: 0.4rem;
    }
  }
</style>
