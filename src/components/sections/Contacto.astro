---
import { Image } from "astro:assets";
import { contactInfo } from "../../data/site";
import monogram from "../../assets/images/Monograma-Blanco.png";
---

<section id="contacto" class="contacto" aria-labelledby="contacto-title">
  <Image
    src={monogram}
    alt=""
    aria-hidden="true"
    width={939}
    height={914}
    class="watermark contacto-watermark"
    style="--wm-invert: 1; --wm-opacity: 0.05;"
    loading="lazy"
  />

  <div class="container grid-12">
    <div class="c-left">
      <p class="eyebrow">Contacto</p>
      <h2 id="contacto-title" class="c-title">Si busca un aliado para sus inversiones.</h2>
      <p>
        Cuéntenos brevemente su interés y un miembro de nuestro equipo se
        pondrá en contacto con usted.
      </p>
      <ul class="c-meta">
        <li>
          <a href={`mailto:${contactInfo.email}`}>
            <span class="c-meta-key">Correo</span> {contactInfo.email}
          </a>
        </li>
        <li>
          <a href={contactInfo.linkedin.href} target="_blank" rel="noopener noreferrer">
            <span class="c-meta-key">LinkedIn</span> {contactInfo.linkedin.label}
          </a>
        </li>
      </ul>
    </div>

    <form class="c-right" data-contact-form novalidate>
      <div class="field">
        <label for="contact-name">Nombre</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Su nombre completo" required />
      </div>
      <div class="field">
        <label for="contact-email">Correo</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="correo@empresa.com" required />
      </div>
      <div class="field">
        <label for="contact-message">Mensaje</label>
        <textarea id="contact-message" name="message" placeholder="Cuéntenos sobre su interés..." required></textarea>
      </div>
      <button class="btn btn--fill submit-btn" type="submit">Enviar mensaje</button>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  // El formulario no tiene backend propio: al enviar, arma el mensaje con
  // los datos capturados y abre WhatsApp (wa.me) con el número de Vítreo,
  // dejando que el usuario complete el envío desde allí.
  const WHATSAPP_NUMBER = "50769819962";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = document.querySelector<HTMLElement>("[data-form-status]");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const message = String(data.get("message") ?? "").trim();

    const text = [
      "Hola, quiero información sobre oportunidades de inversión con Vítreo Capital.",
      "",
      `Nombre: ${name}`,
      `Correo: ${email}`,
      `Mensaje: ${message}`,
    ].join("\n");

    const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;
    window.open(whatsappUrl, "_blank", "noopener,noreferrer");

    if (status) {
      status.textContent = "Te estamos redirigiendo a WhatsApp para completar el envío.";
    }
  });
</script>

<style>
  .contacto {
    background: var(--color-gold);
    color: var(--color-carbon);
    padding: clamp(90px, 12vw, 160px) 0;
    position: relative;
    overflow: hidden;
    min-height: 94svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .contacto-watermark {
    left: -8%;
    bottom: -14%;
    top: auto;
  }

  .grid-12 {
    align-items: end;
  }

  .c-left {
    grid-column: 1 / 6;
    position: relative;
    z-index: 1;
  }
  .c-title {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.05;
    margin-bottom: 1.5rem;
  }
  .c-left > p {
    font-size: 1.05rem;
    max-width: 40ch;
    opacity: 0.85;
    margin-bottom: 2.5rem;
  }

  .c-meta {
    list-style: none;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.5);
  }
  .c-meta a {
    display: flex;
    gap: 1rem;
    font-size: 0.95rem;
    padding: 0.9rem 0;
    color: rgba(46, 45, 44, 0.55);
  }
  .c-meta-key {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    width: 100px;
    flex-shrink: 0;
    font-size: 0.78rem;
    align-self: center;
    color: var(--color-carbon);
  }

  .c-right {
    grid-column: 7 / 13;
    position: relative;
    z-index: 1;
  }

  .field {
    margin-bottom: 0.9rem;
  }
  .field label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .field input,
  .field textarea {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-carbon);
    padding: 0.7rem 0.2rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-carbon);
    font-weight: 400;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: rgba(46, 45, 44, 0.45);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--color-white);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--color-carbon);
    outline-offset: 3px;
  }
  .field textarea {
    resize: vertical;
    min-height: 65px;
  }

  .submit-btn {
    width: 100%;
    justify-content: center;
  }

  .form-status {
    margin-top: 1rem;
    font-size: 0.85rem;
    min-height: 1.2em;
  }

  @media (max-width: 900px) {
    .c-left,
    .c-right {
      grid-column: 1 / -1;
    }
  }
</style>
