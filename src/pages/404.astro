---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada">
  <section class="not-found">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1>Esta página no existe.</h1>
      <p>El enlace pudo haber cambiado o ya no está disponible.</p>
      <a href="/" class="btn btn--fill">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding: clamp(90px, 12vw, 160px) 0;
  }
  .not-found h1 {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
  }
  .not-found > .container > p:last-of-type {
    margin-bottom: 2rem;
    color: var(--color-gray-dark);
  }
</style>
